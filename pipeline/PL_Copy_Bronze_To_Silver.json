{
	"name": "PL_Copy_Bronze_To_Silver",
	"properties": {
		"activities": [
			{
				"name": "Copy_rhu",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "bronze//dummy_customers.csv"
