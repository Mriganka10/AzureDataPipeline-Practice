							"ContainerName": "bronze",
							"DirectoryName": {
								"value": "@string('')",
								"type": "Expression"
							},
							"FileName": "Customers.csv"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_DelimitedText_Parameterized",
						"type": "DatasetReference",
						"parameters": {
							"ContainerName": "silver",
							"DirectoryName": "customers",
							"FileName": "customers_copy.csv"
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-19T07:57:05Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
