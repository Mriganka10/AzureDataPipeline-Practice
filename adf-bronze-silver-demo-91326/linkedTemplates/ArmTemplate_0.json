		{
			"name": "[concat(parameters('factoryName'), '/DS_DelimitedText_Parameterized')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_Blob_Parameterized",
					"type": "LinkedServiceReference",
					"parameters": {
						"StorageAccountName": "stbronzesilver91326"
					}
				},
				"parameters": {
					"ContainerName": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"DirectoryName": {
						"type": "string",
						"defaultValue": "customers"
					},
					"FileName": {
						"type": "string",
						"defaultValue": "customers.csv"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().FileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().DirectoryName",
							"type": "Expression"
						},
						"container": {
							"value": "@dataset().ContainerName",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
