{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-bronze-silver-demo-91326"
		},
		"LS_AzureBlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlobStorage'"
		},
		"LS_Blob_Parameterized_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_Blob_Parameterized'",
			"defaultValue": "DefaultEndpointsProtocol=https;AccountName=@{linkedService().StorageAccountName};EndpointSuffix=core.windows.net;"
		},
		"LS_KeyVault_ADF_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-adf91326-lab01.vault.azure.net/"
		},
		"LS_REST_JSONPlaceholder_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com"
		},
		"LS_AzureSQL_SQLPracticeDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mriganka-sql-learning-2026.database.windows.net"
		},
		"LS_AzureSQL_SQLPracticeDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQLPracticeDB"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-bronze-silver-demo-91326_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureBlobStorage_connectionString": {
						"value": "[parameters('LS_AzureBlobStorage_connectionString')]"
					},
					"LS_Blob_Parameterized_connectionString": {
						"value": "[parameters('LS_Blob_Parameterized_connectionString')]"
					},
					"LS_KeyVault_ADF_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_ADF_properties_typeProperties_baseUrl')]"
					},
					"LS_REST_JSONPlaceholder_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_JSONPlaceholder_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_SQLPracticeDB_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_SQLPracticeDB_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_SQLPracticeDB_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_SQLPracticeDB_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}